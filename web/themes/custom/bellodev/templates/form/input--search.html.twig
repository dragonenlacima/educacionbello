{#
/**
 * @file
 * Default theme implementation for an 'input' #type form element.
 *
 * Available variables:
 * - attributes: A list of HTML attributes for the input element.
 * - children: Optional additional rendered elements.
 * - is_search_block_input: Boolean indicating if this is the search block input.
 *
 * @see\Drupal\Core\Form\FormPreprocess::preprocessInput()
 *
 * @ingroup themeable
 */
#}
{# No agregar 'fieldtext' si es el input del bloque de búsqueda #}
{% if is_search_block_input is defined and is_search_block_input %}
  <input{{attributes}}/>
{% else %}
  <input{{attributes.addClass('w-full', 'py-2', 'px-4', 'rounded', 'border', 'border-silver-400', 'mb-4')}}/>
{% endif %}
{{ children }}
