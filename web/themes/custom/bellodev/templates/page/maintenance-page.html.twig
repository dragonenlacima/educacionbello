{#
/**
 * @file
 * Default theme implementation to display a single Drupal page while offline.
 *
 * All available variables are mirrored in page.html.twig.
 * Some may be blank but they are provided for consistency.
 *
 * @see \Drupal\Core\Theme\ThemePreprocess::preprocessMaintenancePage()
 *
 * @ingroup themeable
 */
#}
<div
	class="min-h-screen bg-linear-to-br from-blue-500 via-blue-600 to-blue-800 flex items-center justify-center p-4">

	{# Main maintenance card - centered with flexbox #}
	<div
		class="w-full max-w-2xl bg-white/95 backdrop-blur-lg rounded-3xl shadow-2xl p-8 md:p-12 lg:p-16">

		{# Logo section #}
		{% if logo_image %}
			<div class="flex justify-center mb-8">
				<div class="bg-white rounded-2xl p-6 shadow-lg hover:shadow-xl transition-shadow duration-300">
					<img src="{{ logo_image }}" alt="{{ site_name }}" class="h-20 w-auto object-contain"/>
				</div>
			</div>
		{% endif %}

		{# Site name #}
		{% if site_name %}
			<h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-center text-gray-800 mb-6">
				{{ site_name }}
			</h1>
		{% endif %}

		{# Maintenance icon #}
		<div class="flex justify-center mb-6">
			<svg class="w-16 h-16 text-blue-600 animate-spin" style="animation-duration: 3s;" fill="none" stroke="currentColor" viewbox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
			</svg>
		</div>

		{# Maintenance message #}
		<div class="text-center mb-8">
			{% if maintenance_message %}
				<div class="text-lg md:text-xl text-gray-700 leading-relaxed">
					{{ maintenance_message }}
				</div>
			{% else %}
				<h2 class="text-2xl md:text-3xl font-semibold text-gray-800 mb-4">
					Estamos en Mantenimiento
				</h2>
				<p class="text-lg text-gray-600 mb-2">
					Nuestro sitio web está siendo actualizado para ofrecerte una mejor experiencia.
				</p>
				<p class="text-base text-gray-500">
					Volveremos pronto. Gracias por tu paciencia.
				</p>
			{% endif %}
		</div>

		{# Loading animation #}
		<div class="flex justify-center items-center gap-2 mb-6">
			<div class="w-3 h-3 bg-blue-600 rounded-full animate-bounce"></div>
			<div class="w-3 h-3 bg-blue-600 rounded-full animate-bounce [animation-delay:0.2s]"></div>
			<div class="w-3 h-3 bg-blue-600 rounded-full animate-bounce [animation-delay:0.4s]"></div>
		</div>

		{# Footer info #}
		<div class="mt-8 pt-6 border-t border-gray-200 text-center">
			<p class="text-sm text-gray-500">
				Si necesitas asistencia urgente, por favor contáctanos
			</p>
		</div>

	</div>

</div>
